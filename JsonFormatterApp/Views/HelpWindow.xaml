<Window x:Class="JsonFormatterApp.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JSON Formatter Pro - Help &amp; Documentation"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelHeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="Help Topics"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="10,10,10,15"/>

                <Button Content="🚀 Quick Start"
                        Style="{StaticResource {x:Type Button}}"
                        HorizontalAlignment="Stretch"
                        Margin="5"
                        Padding="10,8"
                        Click="ShowQuickStart_Click"/>

                <Button Content="⌨️ Keyboard Shortcuts"
                        Style="{StaticResource {x:Type Button}}"
                        HorizontalAlignment="Stretch"
                        Margin="5"
                        Padding="10,8"
                        Click="ShowKeyboardShortcuts_Click"/>

                <Button Content="📝 Features Guide"
                        Style="{StaticResource {x:Type Button}}"
                        HorizontalAlignment="Stretch"
                        Margin="5"
                        Padding="10,8"
                        Click="ShowFeatures_Click"/>

                <Button Content="🔧 Conversion Tools"
                        Style="{StaticResource {x:Type Button}}"
                        HorizontalAlignment="Stretch"
                        Margin="5"
                        Padding="10,8"
                        Click="ShowConversion_Click"/>

                <Button Content="❓ FAQ"
                        Style="{StaticResource {x:Type Button}}"
                        HorizontalAlignment="Stretch"
                        Margin="5"
                        Padding="10,8"
                        Click="ShowFAQ_Click"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="30">
            <StackPanel x:Name="ContentPanel">
                <!-- Content will be dynamically loaded here -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
