<Window x:Class="JsonFormatterApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:converters="clr-namespace:JsonFormatterApp.Converters"
        xmlns:helpers="clr-namespace:JsonFormatterApp.Helpers"
        mc:Ignorable="d"
        Title="JSON Formatter &amp; Validator Pro"
        Height="800" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FormatJsonCommand}"/>
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding MinifyJsonCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewFileCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding ToggleThemeCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{DynamicResource MenuBackgroundBrush}">
            <MenuItem Header="_File" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="_New" Command="{Binding NewFileCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="Recent Files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <MenuItem Header="{Binding FilePath}"
                                      Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding FilePath}"/>
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <MenuItem Header="Clear Recent Files" Command="{Binding ClearRecentFilesCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="_Edit" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}"/>
                <Separator/>
                <MenuItem Header="_Format JSON" Command="{Binding FormatJsonCommand}" InputGestureText="Ctrl+F"/>
                <MenuItem Header="_Minify JSON" Command="{Binding MinifyJsonCommand}" InputGestureText="Ctrl+M"/>
                <MenuItem Header="_Validate JSON" Command="{Binding ValidateJsonCommand}"/>
            </MenuItem>

            <MenuItem Header="_Tools" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="Convert to _XML" Command="{Binding ConvertToXmlCommand}"/>
                <MenuItem Header="Convert to _C# Classes" Command="{Binding ConvertToCSharpCommand}"/>
                <MenuItem Header="Convert to _SQL" Command="{Binding ConvertToSqlCommand}"/>
                <MenuItem Header="Convert to _YAML" Command="{Binding ConvertToYamlCommand}"/>
                <Separator/>
                <MenuItem Header="Base64 _Encode" Command="{Binding Base64EncodeCommand}"/>
                <MenuItem Header="Base64 _Decode" Command="{Binding Base64DecodeCommand}"/>
                <MenuItem Header="URL Encode" Command="{Binding UrlEncodeCommand}"/>
                <MenuItem Header="URL Decode" Command="{Binding UrlDecodeCommand}"/>
                <Separator/>
                <MenuItem Header="Validate Against _Schema..." Command="{Binding ValidateSchemaCommand}"/>
                <MenuItem Header="_Compare with File..." Command="{Binding CompareJsonCommand}"/>
            </MenuItem>

            <MenuItem Header="_View" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="Toggle _Theme" Command="{Binding ToggleThemeCommand}" InputGestureText="Ctrl+T"/>
                <MenuItem Header="Refresh _Tree" Command="{Binding BuildTreeCommand}"/>
                <MenuItem Header="Refresh _Table" Command="{Binding BuildTableCommand}"/>
            </MenuItem>

            <MenuItem Header="_Help" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" Padding="5">
            <Button Command="{Binding NewFileCommand}" ToolTip="New (Ctrl+N)" Padding="5">
                <TextBlock Text="📄 New" FontSize="12"/>
            </Button>
            <Button Command="{Binding OpenFileCommand}" ToolTip="Open (Ctrl+O)" Padding="5">
                <TextBlock Text="📂 Open" FontSize="12"/>
            </Button>
            <Button Command="{Binding SaveFileCommand}" ToolTip="Save (Ctrl+S)" Padding="5">
                <TextBlock Text="💾 Save" FontSize="12"/>
            </Button>
            <Separator/>
            <Button Command="{Binding BuildTreeCommand}" ToolTip="Refresh Tree View" Padding="5">
                <TextBlock Text="🌳 Tree" FontSize="12"/>
            </Button>
            <Button Command="{Binding BuildTableCommand}" ToolTip="Refresh Table View" Padding="5">
                <TextBlock Text="📊 Table" FontSize="12"/>
            </Button>
            <Separator/>
            <Button Command="{Binding ToggleThemeCommand}" ToolTip="Toggle Theme (Ctrl+T)" Padding="5">
                <TextBlock Text="🌙 Theme" FontSize="12"/>
            </Button>
            <Separator/>
            <TextBlock Text="Indent:" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource ForegroundBrush}"/>
            <ComboBox SelectedItem="{Binding IndentSize}" Width="60">
                <ComboBoxItem Content="2" Tag="2" IsSelected="True"/>
                <ComboBoxItem Content="4" Tag="4"/>
            </ComboBox>
        </ToolBar>

        <!-- Main Editor Content -->
        <Grid Grid.Row="2" DataContext="{Binding Document}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Text Editor -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="5">
                    <TextBlock Text="JSON Editor" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                </Border>

                <!-- Quick Action Toolbar -->
                <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Command="{Binding DataContext.FormatJsonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="10,5"
                                Margin="0,0,5,0"
                                ToolTip="Format JSON (Ctrl+F)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Format" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DataContext.MinifyJsonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="10,5"
                                Margin="0,0,5,0"
                                ToolTip="Minify JSON (Ctrl+M)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Minify" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DataContext.ValidateJsonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="10,5"
                                Margin="0,0,5,0"
                                ToolTip="Validate JSON">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Validate" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="10,0"/>

                        <Button Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="10,5"
                                Margin="0,0,5,0"
                                ToolTip="Copy to Clipboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Copy"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Padding="10,5"
                                ToolTip="Paste from Clipboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Paste"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <avalonEdit:TextEditor x:Name="JsonEditor"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           ShowLineNumbers="True"
                                           SyntaxHighlighting="JavaScript"
                                           Background="{DynamicResource EditorBackgroundBrush}"
                                           Foreground="{DynamicResource EditorForegroundBrush}"
                                           LineNumbersForeground="{DynamicResource LineNumbersForegroundBrush}"
                                           VerticalScrollBarVisibility="Auto"
                                           HorizontalScrollBarVisibility="Auto"
                                           helpers:AvalonEditBehavior.BindableText="{Binding JsonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>

            <!-- Right Panel: Tree and Table Views -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="5">
                    <TextBlock Text="Views" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                </Border>

                <TabControl Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
                    <!-- Tree View Tab -->
                    <TabItem Header="Tree">
                        <Grid Background="{DynamicResource TreeBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search Toolbar -->
                            <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍 Filter:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,5,0"/>
                                    <TextBox Width="300" Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource EditorBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Padding="5" VerticalAlignment="Center" ToolTip="Filter by key or value. Add multiple terms to narrow results (e.g., 'postcode 2150' shows only nodes with both terms)"/>
                                    <TextBlock Foreground="{DynamicResource ForegroundBrush}" Margin="15,0,0,0" VerticalAlignment="Center" FontStyle="Italic" Text="Multiple terms act as filters (all terms must match)"/>
                                </StackPanel>
                            </Border>

                            <!-- Tree View -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource TreeBackgroundBrush}">
                                <TreeView ItemsSource="{Binding FilteredTreeNodes}" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Key}" FontWeight="Bold" Margin="0,0,5,0"/>
                                                <TextBlock Text=": " Margin="0,0,3,0"/>
                                                <TextBlock Text="{Binding Value}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="String">
                                                                    <Setter Property="Foreground" Value="#CE9178"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Number">
                                                                    <Setter Property="Foreground" Value="#B5CEA8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                                                    <Setter Property="Foreground" Value="#569CD6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Null">
                                                                    <Setter Property="Foreground" Value="#808080"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Table View Tab (Simple) -->
                    <TabItem Header="Table">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource TreeBackgroundBrush}">
                            <DataGrid ItemsSource="{Binding TableData}"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      Background="{DynamicResource TreeBackgroundBrush}"
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      GridLinesVisibility="All"
                                      HeadersVisibility="All"
                                      AlternatingRowBackground="{DynamicResource EditorBackgroundBrush}"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="True">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource PanelHeaderBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <!-- All Tables View Tab -->
                    <TabItem Header="All Tables">
                        <Grid Background="{DynamicResource TreeBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Table Selector -->
                            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Select Table:" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AllTables}" SelectedItem="{Binding SelectedTable}" DisplayMemberPath="Description" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Search and Export Toolbar -->
                            <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Box -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                        <TextBlock Text="🔍 Filter:" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,5,0"/>
                                        <TextBox Width="250" Text="{Binding SelectedTable.SearchText, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource EditorBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Padding="5" VerticalAlignment="Center" ToolTip="Filter rows by content. Add multiple terms to narrow results (e.g., 'NSW 2150' shows only rows containing both terms in any column)"/>
                                    </StackPanel>

                                    <!-- Table Stats -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" Margin="10,0,0,0">
                                            <Run Text="Showing:"/>
                                            <Run Text="{Binding SelectedTable.FilteredData.Count, Mode=OneWay, FallbackValue=0}" FontWeight="Bold"/>
                                            <Run Text="of"/>
                                            <Run Text="{Binding SelectedTable.RowCount, Mode=OneWay, FallbackValue=0}" FontWeight="Bold"/>
                                            <Run Text="rows"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" Margin="15,0,0,0" Visibility="{Binding SelectedTable.HasNestedTables, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                            <Run Text="📋"/>
                                            <Run Text="{Binding SelectedTable.NestedTableCount, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text="nested tables"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Export Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.ExportTableToCsvCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Padding="8,4" Margin="0,0,5,0" ToolTip="Export to CSV">
                                            <TextBlock Text="📊 CSV"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ExportTableToHtmlCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Padding="8,4" Margin="0,0,5,0" ToolTip="Export to HTML">
                                            <TextBlock Text="🌐 HTML"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ExportTableToJsonCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Padding="8,4" ToolTip="Export to JSON">
                                            <TextBlock Text="💾 JSON"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Selected Table Display -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <!-- Table Info -->
                                    <Border Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5">
                                                <Run Text="📊 Table: "/>
                                                <Run Text="{Binding SelectedTable.Name, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource ForegroundBrush}">
                                                <Run Text="📁 Path: "/>
                                                <Run Text="{Binding SelectedTable.Path, Mode=OneWay}" FontStyle="Italic"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource ForegroundBrush}">
                                                <Run Text="📏 Rows: "/>
                                                <Run Text="{Binding SelectedTable.RowCount, Mode=OneWay}" FontWeight="Bold"/>
                                                <Run Text=" | Columns: "/>
                                                <Run Text="{Binding SelectedTable.ColumnCount, Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Main Data Grid -->
                                    <DataGrid ItemsSource="{Binding SelectedTable.FilteredData}"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              Background="{DynamicResource TreeBackgroundBrush}"
                                              Foreground="{DynamicResource ForegroundBrush}"
                                              GridLinesVisibility="All"
                                              HeadersVisibility="All"
                                              AlternatingRowBackground="{DynamicResource EditorBackgroundBrush}"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="True"
                                              CanUserResizeColumns="True"
                                              CanUserResizeRows="False"
                                              CanUserSortColumns="True"
                                              MaxHeight="400"
                                              Margin="0,0,0,10">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="{DynamicResource PanelHeaderBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="5"/>
                                            </Style>
                                        </DataGrid.Resources>
                                    </DataGrid>

                                    <!-- Nested Tables Section -->
                                    <Border Background="{DynamicResource EditorBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Nested Tables &amp; Objects" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

                                            <ItemsControl ItemsSource="{Binding SelectedTable.NestedTables}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander Header="{Binding Value.Path}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <Border Background="{DynamicResource TreeBackgroundBrush}" Padding="10" Margin="5">
                                                                <StackPanel>
                                                                    <TextBlock Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5">
                                                                        <Run Text="Type: "/>
                                                                        <Run Text="{Binding Value.Type, Mode=OneWay}" FontWeight="Bold"/>
                                                                        <Run Text=" | Parent Column: "/>
                                                                        <Run Text="{Binding Value.ParentColumn, Mode=OneWay}" FontWeight="Bold"/>
                                                                        <Run Text=" | Row: "/>
                                                                        <Run Text="{Binding Value.ParentRow, Mode=OneWay}" FontWeight="Bold"/>
                                                                    </TextBlock>

                                                                    <DataGrid ItemsSource="{Binding Value.NestedTable.Data}"
                                                                              AutoGenerateColumns="True"
                                                                              IsReadOnly="True"
                                                                              Background="{DynamicResource TreeBackgroundBrush}"
                                                                              Foreground="{DynamicResource ForegroundBrush}"
                                                                              GridLinesVisibility="All"
                                                                              HeadersVisibility="All"
                                                                              AlternatingRowBackground="{DynamicResource EditorBackgroundBrush}"
                                                                              CanUserAddRows="False"
                                                                              CanUserDeleteRows="False"
                                                                              MaxHeight="300">
                                                                        <DataGrid.Resources>
                                                                            <Style TargetType="DataGridColumnHeader">
                                                                                <Setter Property="Background" Value="{DynamicResource PanelHeaderBrush}"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                <Setter Property="Padding" Value="5"/>
                                                                            </Style>
                                                                        </DataGrid.Resources>
                                                                    </DataGrid>
                                                                </StackPanel>
                                                            </Border>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Document.StatusMessage}"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border CornerRadius="3" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#16825D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Document.IsValid}" Value="False">
                                        <Setter Property="Background" Value="#D13438"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✓ Valid JSON"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Document.IsValid}" Value="False">
                                            <Setter Property="Text" Value="✗ Invalid JSON"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding Document.FilePath, StringFormat='File: {0}'}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Visibility="{Binding Document.FilePath, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
