<Window x:Class="JsonFormatterApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:converters="clr-namespace:JsonFormatterApp.Converters"
        mc:Ignorable="d"
        Title="JSON Formatter &amp; Validator Pro - Multi-Tab Edition"
        Height="800" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FormatJsonCommand}"/>
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding MinifyJsonCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewFileCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{DynamicResource MenuBackgroundBrush}">
            <MenuItem Header="_File" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="_New Tab" Command="{Binding NewFileCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="_Close Tab" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" InputGestureText="Ctrl+W"/>
                <Separator/>
                <MenuItem Header="Recent Files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <MenuItem Header="{Binding FilePath}"
                                      Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding FilePath}"/>
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <MenuItem Header="Clear Recent Files" Command="{Binding ClearRecentFilesCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="_Edit" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}"/>
                <Separator/>
                <MenuItem Header="_Format JSON" Command="{Binding FormatJsonCommand}" InputGestureText="Ctrl+F"/>
                <MenuItem Header="_Minify JSON" Command="{Binding MinifyJsonCommand}" InputGestureText="Ctrl+M"/>
                <MenuItem Header="_Validate JSON" Command="{Binding ValidateJsonCommand}"/>
            </MenuItem>

            <MenuItem Header="_Tools" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="Convert to _XML" Command="{Binding ConvertToXmlCommand}"/>
                <MenuItem Header="Convert to _C# Classes" Command="{Binding ConvertToCSharpCommand}"/>
                <MenuItem Header="Convert to _SQL" Command="{Binding ConvertToSqlCommand}"/>
                <MenuItem Header="Convert to _YAML" Command="{Binding ConvertToYamlCommand}"/>
                <Separator/>
                <MenuItem Header="Base64 _Encode" Command="{Binding Base64EncodeCommand}"/>
                <MenuItem Header="Base64 _Decode" Command="{Binding Base64DecodeCommand}"/>
                <MenuItem Header="URL Encode" Command="{Binding UrlEncodeCommand}"/>
                <MenuItem Header="URL Decode" Command="{Binding UrlDecodeCommand}"/>
                <Separator/>
                <MenuItem Header="Validate Against _Schema..." Command="{Binding ValidateSchemaCommand}"/>
                <MenuItem Header="_Compare with File..." Command="{Binding CompareJsonCommand}"/>
                <MenuItem Header="Compare _Tabs..." Command="{Binding CompareTabsCommand}"/>
            </MenuItem>

            <MenuItem Header="_View" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="Toggle _Theme" Command="{Binding ToggleThemeCommand}" InputGestureText="Ctrl+T"/>
                <MenuItem Header="Refresh _Tree" Command="{Binding BuildTreeCommand}"/>
                <MenuItem Header="Refresh _Table" Command="{Binding BuildTableCommand}"/>
            </MenuItem>

            <MenuItem Header="_Help" Foreground="{DynamicResource ForegroundBrush}">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" Padding="5">
            <Button Command="{Binding NewFileCommand}" ToolTip="New Tab (Ctrl+N)" Padding="5">
                <TextBlock Text="📄 New" FontSize="12"/>
            </Button>
            <Button Command="{Binding OpenFileCommand}" ToolTip="Open (Ctrl+O)" Padding="5">
                <TextBlock Text="📂 Open" FontSize="12"/>
            </Button>
            <Button Command="{Binding SaveFileCommand}" ToolTip="Save (Ctrl+S)" Padding="5">
                <TextBlock Text="💾 Save" FontSize="12"/>
            </Button>
            <Separator/>
            <Button Command="{Binding FormatJsonCommand}" ToolTip="Format JSON (Ctrl+F)" Padding="5">
                <TextBlock Text="✨ Format" FontSize="12" FontWeight="Bold"/>
            </Button>
            <Button Command="{Binding MinifyJsonCommand}" ToolTip="Minify JSON (Ctrl+M)" Padding="5">
                <TextBlock Text="⚡ Minify" FontSize="12" FontWeight="Bold"/>
            </Button>
            <Button Command="{Binding ValidateJsonCommand}" ToolTip="Validate JSON" Padding="5">
                <TextBlock Text="✓ Validate" FontSize="12" FontWeight="Bold"/>
            </Button>
            <Separator/>
            <Button Command="{Binding BuildTreeCommand}" ToolTip="Refresh Tree View" Padding="5">
                <TextBlock Text="🌳 Tree" FontSize="12"/>
            </Button>
            <Button Command="{Binding BuildTableCommand}" ToolTip="Refresh Table View" Padding="5">
                <TextBlock Text="📊 Table" FontSize="12"/>
            </Button>
            <Separator/>
            <Button Command="{Binding CompareTabsCommand}" ToolTip="Compare Tabs" Padding="5">
                <TextBlock Text="🔀 Compare" FontSize="12"/>
            </Button>
            <Separator/>
            <Button Command="{Binding ToggleThemeCommand}" ToolTip="Toggle Theme (Ctrl+T)" Padding="5">
                <TextBlock Text="🌙 Theme" FontSize="12"/>
            </Button>
            <Separator/>
            <TextBlock Text="Indent:" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource ForegroundBrush}"/>
            <ComboBox SelectedItem="{Binding IndentSize}" Width="60">
                <ComboBoxItem Content="2" Tag="2" IsSelected="True"/>
                <ComboBoxItem Content="4" Tag="4"/>
            </ComboBox>
        </ToolBar>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="2"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}">

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                        <Button Content="✕"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="10,0,0,0"
                                Padding="5,0"
                                FontSize="14"
                                ToolTip="Close Tab (Ctrl+W)"
                                Cursor="Hand"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: Text Editor -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="5">
                                <TextBlock Text="JSON Editor" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                            </Border>

                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <avalonEdit:TextEditor x:Name="JsonEditor"
                                                       FontFamily="Consolas"
                                                       FontSize="13"
                                                       ShowLineNumbers="True"
                                                       SyntaxHighlighting="JavaScript"
                                                       Background="{DynamicResource EditorBackgroundBrush}"
                                                       Foreground="{DynamicResource EditorForegroundBrush}"
                                                       LineNumbersForeground="{DynamicResource LineNumbersForegroundBrush}"
                                                       VerticalScrollBarVisibility="Auto"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       Loaded="JsonEditor_Loaded"
                                                       Unloaded="JsonEditor_Unloaded"/>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>

                        <!-- Right Panel: Tree and Table Views -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="5">
                                <TextBlock Text="Views" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
                            </Border>

                            <TabControl Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
                                <!-- Tree View Tab -->
                                <TabItem Header="Tree">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource TreeBackgroundBrush}">
                                        <TreeView ItemsSource="{Binding TreeNodes}" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}">
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Key}" FontWeight="Bold" Margin="0,0,5,0"/>
                                                        <TextBlock Text=": " Margin="0,0,3,0"/>
                                                        <TextBlock Text="{Binding Value}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="String">
                                                                            <Setter Property="Foreground" Value="#CE9178"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Number">
                                                                            <Setter Property="Foreground" Value="#B5CEA8"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                                                            <Setter Property="Foreground" Value="#569CD6"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="Null">
                                                                            <Setter Property="Foreground" Value="#808080"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Border>
                                </TabItem>

                                <!-- Table View Tab -->
                                <TabItem Header="Table">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource TreeBackgroundBrush}">
                                        <DataGrid ItemsSource="{Binding TableData}"
                                                  AutoGenerateColumns="True"
                                                  IsReadOnly="True"
                                                  Background="{DynamicResource TreeBackgroundBrush}"
                                                  Foreground="{DynamicResource ForegroundBrush}"
                                                  GridLinesVisibility="All"
                                                  HeadersVisibility="All"
                                                  AlternatingRowBackground="{DynamicResource EditorBackgroundBrush}"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="True"
                                                  CanUserResizeColumns="True"
                                                  CanUserResizeRows="False"
                                                  CanUserSortColumns="True">
                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="{DynamicResource PanelHeaderBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Padding" Value="5"/>
                                                </Style>
                                            </DataGrid.Resources>
                                        </DataGrid>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedTab.StatusMessage}"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border CornerRadius="3" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#16825D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.IsValid}" Value="False">
                                        <Setter Property="Background" Value="#D13438"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✓ Valid JSON"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab.IsValid}" Value="False">
                                            <Setter Property="Text" Value="✗ Invalid JSON"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding SelectedTab.FilePath, StringFormat='File: {0}'}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Visibility="{Binding SelectedTab.FilePath, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Tabs.Count, StringFormat='Tabs: {0}'}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
