<Window x:Class="JsonFormatterApp.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Compare JSON Files"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="JSON Comparison"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundBrush}"/>

        <!-- Side-by-side comparison -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="5">
                    <TextBlock Text="{Binding LeftTitle}" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                </Border>

                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <avalonEdit:TextEditor x:Name="LeftEditor"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           IsReadOnly="True"
                                           ShowLineNumbers="True"
                                           SyntaxHighlighting="JavaScript"
                                           Background="{DynamicResource EditorBackgroundBrush}"
                                           Foreground="{DynamicResource EditorForegroundBrush}"
                                           LineNumbersForeground="{DynamicResource LineNumbersForegroundBrush}"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>

            <!-- Right Panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="5">
                    <TextBlock Text="{Binding RightTitle}" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                </Border>

                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <avalonEdit:TextEditor x:Name="RightEditor"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           IsReadOnly="True"
                                           ShowLineNumbers="True"
                                           SyntaxHighlighting="JavaScript"
                                           Background="{DynamicResource EditorBackgroundBrush}"
                                           Foreground="{DynamicResource EditorForegroundBrush}"
                                           LineNumbersForeground="{DynamicResource LineNumbersForegroundBrush}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Differences Header -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelHeaderBrush}"
                Padding="5"
                Margin="0,10,0,0">
            <TextBlock Text="Differences Found"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="{DynamicResource ForegroundBrush}"/>
        </Border>

        <!-- Differences List -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource EditorBackgroundBrush}">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Differences}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="5"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           FontFamily="Consolas"
                                           FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
