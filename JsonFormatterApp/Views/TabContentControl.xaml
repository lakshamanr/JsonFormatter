<UserControl x:Class="JsonFormatterApp.Views.TabContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:helpers="clr-namespace:JsonFormatterApp.Helpers">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Text Editor -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="5">
                <TextBlock Text="JSON Editor" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
            </Border>

            <!-- Quick Action Toolbar for this tab -->
            <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding DataContext.FormatJsonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ForegroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Padding="10,5"
                            Margin="0,0,5,0"
                            ToolTip="Format JSON (Ctrl+F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Format" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DataContext.MinifyJsonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ForegroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Padding="10,5"
                            Margin="0,0,5,0"
                            ToolTip="Minify JSON (Ctrl+M)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Minify" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DataContext.ValidateJsonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ForegroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Padding="10,5"
                            Margin="0,0,5,0"
                            ToolTip="Validate JSON">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Validate" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="10,0"/>

                    <Button Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ForegroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Padding="10,5"
                            Margin="0,0,5,0"
                            ToolTip="Copy to Clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ForegroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Padding="10,5"
                            ToolTip="Paste from Clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Paste"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <avalonEdit:TextEditor x:Name="JsonEditor"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       ShowLineNumbers="True"
                                       SyntaxHighlighting="JavaScript"
                                       Background="{DynamicResource EditorBackgroundBrush}"
                                       Foreground="{DynamicResource EditorForegroundBrush}"
                                       LineNumbersForeground="{DynamicResource LineNumbersForegroundBrush}"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Auto"
                                       helpers:AvalonEditBehavior.BindableText="{Binding JsonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"/>

        <!-- Right Panel: Tree and Table Views -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}" Padding="5">
                <TextBlock Text="Views" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
            </Border>

            <TabControl Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
                <!-- Tree View Tab -->
                <TabItem Header="Tree">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource TreeBackgroundBrush}">
                        <TreeView ItemsSource="{Binding TreeNodes}" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Key}" FontWeight="Bold" Margin="0,0,5,0"/>
                                        <TextBlock Text=": " Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Value}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="String">
                                                            <Setter Property="Foreground" Value="#CE9178"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Number">
                                                            <Setter Property="Foreground" Value="#B5CEA8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                                            <Setter Property="Foreground" Value="#569CD6"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Null">
                                                            <Setter Property="Foreground" Value="#808080"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>
                </TabItem>

                <!-- Table View Tab -->
                <TabItem Header="Table">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource TreeBackgroundBrush}">
                        <DataGrid ItemsSource="{Binding TableData}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  Background="{DynamicResource TreeBackgroundBrush}"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="All"
                                  AlternatingRowBackground="{DynamicResource EditorBackgroundBrush}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="True">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource PanelHeaderBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
