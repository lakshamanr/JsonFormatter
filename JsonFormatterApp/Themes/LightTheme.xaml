<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="LineNumbersForegroundBrush" Color="#2B91AF"/>
    <SolidColorBrush x:Key="TreeBackgroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="StatusIndicatorBrush" Color="#16825D"/>

    <!-- Button Styles -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#E1E1E1"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#ADADAD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C5C5C5"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox Styles -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="CaretBrush" Value="#000000"/>
        <Setter Property="SelectionBrush" Value="#ADD6FF"/>
    </Style>

    <!-- ComboBox Styles -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
    </Style>

    <!-- MenuItem Styles -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="#F3F3F3"/>
        <Setter Property="Foreground" Value="#000000"/>
    </Style>

    <!-- TreeViewItem Styles -->
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="#000000"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#CCE8FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
